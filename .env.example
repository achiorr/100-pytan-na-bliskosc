# MailerLite API Configuration
# Wygeneruj klucz API w MailerLite: Integrations -> API -> Generate new token
MAILERLITE_API_KEY=twoj_klucz_api_z_mailerlite

# ID grupy subskrybentów w MailerLite (opcjonalne, ale zalecane):
# Znajdziesz w MailerLite: Subscribers -> Groups -> [Twoja grupa] -> ID w URL lub ustawieniach
MAILERLITE_GROUP_ID=twoj_id_grupy

# Facebook / Meta Pixel ID (opcjonalnie, domyślnie w kodzie):
NEXT_PUBLIC_FB_PIXEL_ID=932014270181668
